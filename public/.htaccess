DirectoryIndex index.html

RewriteEngine On

# Keep macchinamilano.it as the only canonical, encrypted public URL.
# This also redirects macchinamilano.com and both www hostnames.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^macchinamilano\.it$ [NC]
RewriteRule ^ https://macchinamilano.it%{REQUEST_URI} [R=301,L]

# Serve exported Next.js directories without exposing index.html.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Exported pages may be revalidated quickly while the CDN keeps a short,
  # stale copy available during origin refreshes.
  <FilesMatch "\.(?:html?|json)$">
    Header set Cache-Control "public, max-age=0, s-maxage=300, stale-while-revalidate=86400"
  </FilesMatch>

  # Next.js fingerprints these assets, so they are safe to cache permanently.
  <FilesMatch "\.(?:css|js|mjs|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Public visual assets keep a shorter lifetime because their filenames are
  # not always content-hashed.
  <FilesMatch "\.(?:avif|gif|ico|jpe?g|png|svg|webp)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/avif "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
</IfModule>
